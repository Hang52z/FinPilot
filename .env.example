# Copy to .env and adjust. Never commit .env.

# Backend environment: development | test | production
ENV=development

# Local database credentials. Use strong secrets outside local development.
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=finpilot
POSTGRES_DB=finpilot

# Browser origins allowed to call the API, as a JSON list.
# Production: the web app's address, e.g. ["https://finpilot.example.com"]
CORS_ORIGINS=["http://localhost:8081"]
